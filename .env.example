# Contrasena de acceso al repositorio de procesos
APP_PASSWORD=procesos2026

# Secreto para firmar la cookie de sesion (cadena aleatoria larga)
SESSION_SECRET=cambiar-por-una-cadena-aleatoria-larga

# Clave de la API de Anthropic para el Asistente de Procesos (opcional).
# Sin esta clave el asistente responde en modo local, con respuestas
# construidas a partir de la documentacion cargada en la herramienta.
ANTHROPIC_API_KEY=

# Modelo a utilizar (opcional)
ANTHROPIC_MODEL=claude-sonnet-5
